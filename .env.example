# ---------------------------------------------------------------------
# MediaBuyer OS — environment configuration
#
# Copy to `.env.local` (git-ignored) and fill in real values.
# Leave BOTH blank to run in demo mode (in-memory data, nothing persisted).
#
# Only VITE_-prefixed variables are exposed to the browser. NEVER put a
# service_role key, ad-platform app secret, or webhook signing secret here —
# everything in this file ends up in the public JS bundle.
# ---------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
